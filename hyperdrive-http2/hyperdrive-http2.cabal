cabal-version:      3.0
name:               hyperdrive-http2
version:            0.1.0.0
synopsis:           HTTP/2 (RFC 9113) and HPACK (RFC 7541) for hyperdrive
description:
  The HTTP/2 protocol layer of hyperdrive. It does no IO. The modules
  under Hyperdrive.HPACK that QPACK (RFC 9204) also uses, the prefixed
  integers and the Huffman code, depend on nothing of HTTP/2's
  (docs/http2-core-design.md, D1).
license:            BSD-3-Clause
license-file:       LICENSE
author:             Jeremy Shaw
maintainer:         jeremy@seereason.com
category:           Web
build-type:         Simple
extra-source-files: test/data/README.md
                    test/data/*.txt

-- The differential tests against nghttp2's HPACK need its C library:
-- scripts/differential-nghttp2 runs them.
flag nghttp2
  description: Build the differential tests against nghttp2
  default:     False
  manual:      True

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  ghc-options:      -O2
  exposed-modules:  Hyperdrive.HPACK.Decode
                    Hyperdrive.HPACK.Encode
                    Hyperdrive.HPACK.Huffman
                    Hyperdrive.HPACK.Integer
                    Hyperdrive.HPACK.Table
                    Hyperdrive.HTTP2.Connection
                    Hyperdrive.HTTP2.Frame
  build-depends:    base                 >= 4.18 && < 5
                  , array                >= 0.5  && < 0.6
                  , bytestring           >= 0.11 && < 0.13
                  , containers           >= 0.6  && < 0.8
                  , hyperdrive-semantics

test-suite hyperdrive-http2-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    ConnectionTests
                    CorpusTests
                    DecodeTests
                    EncodeTests
                    FrameTests
                    HuffmanTests
                    IntegerTests
                    RFC7541
                    StreamTests
  default-language: GHC2021
  build-depends:    base
                  , aeson            >= 2.0  && < 2.3
                  , base16-bytestring >= 1.0 && < 1.1
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , hyperdrive-http2
                  , hyperdrive-semantics
                  , text
                  , QuickCheck       >= 2.14 && < 2.18
                  , tasty            >= 1.4  && < 1.6
                  , tasty-quickcheck >= 0.10 && < 0.12

test-suite hyperdrive-http2-nghttp2
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test-nghttp2 test
  main-is:          Main.hs
  other-modules:    DecodeTests
                    EncodeTests
                    RFC7541
  default-language: GHC2021
  if flag(nghttp2)
    c-sources:       test-nghttp2/shim.c
    extra-libraries: nghttp2
  else
    buildable: False
  build-depends:    base
                  , bytestring
                  , containers
                  , hyperdrive-http2
                  , QuickCheck       >= 2.14 && < 2.18
                  , tasty            >= 1.4  && < 1.6
                  , tasty-quickcheck >= 0.10 && < 0.12
