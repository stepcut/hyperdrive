cabal-version:      3.0
name:               hyperdrive-bench
version:            0.1.0.0
synopsis:           Benchmark servers: the same application on hyperdrive and on warp
license:            BSD-3-Clause
license-file:       LICENSE
author:             Jeremy Shaw
maintainer:         jeremy@seereason.com
build-type:         Simple

-- Both built the same way, so that only the server differs. The
-- allocation area: with -A32m both servers spent a fifth to a quarter
-- more user time over HTTP/1.1 (docs/benchmarks.md, 2026-11-24); -A2m
-- leaves HTTP/1.1 as -A1m does and makes HTTP/2's small requests 4-15%
-- faster, warp's too (2026-11-27).
common server
  default-language: GHC2021
  ghc-options:      -Wall -O2 -threaded -rtsopts "-with-rtsopts=-N8 -A2m"
  build-depends:    base >= 4.18 && < 5, bytestring

executable bench-hyperdrive
  import:           server
  main-is:          Hyperdrive.hs
  build-depends:    hyperdrive-semantics, hyperdrive-server

-- Off in bench/local.project, which builds the others with cabal in
-- the ordinary dev shell (where warp is not available).
flag warp
  description: build bench-warp
  default:     True
  manual:      True

executable bench-warp
  import:           server
  main-is:          Warp.hs
  if flag(warp)
    build-depends:  http-types, wai, warp, warp-tls
  else
    buildable:      False

-- The driver and the core in process, one connection, no sockets
-- (Driver.hs). Not built with the threaded RTS's parallel GC settings
-- above: it runs on one core.
executable bench-driver
  default-language: GHC2021
  main-is:          Driver.hs
  ghc-options:      -Wall -O2 -threaded -rtsopts "-with-rtsopts=-A1m"
  build-depends:    base >= 4.18 && < 5, bytestring, network, hyperdrive-semantics, hyperdrive-server
