 nameSpan :: ByteString -> Int
 nameSpan (BI.BS fp len) = BI.accursedUnutterablePerformIO $ BI.unsafeWithForeignPtr fp $ \p ->
   case nameTable of
     BI.BS tfp _ -> BI.unsafeWithForeignPtr tfp $ \table -> nameOctets table p len 0 0
