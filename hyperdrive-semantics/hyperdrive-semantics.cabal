cabal-version:      3.0
name:               hyperdrive-semantics
version:            0.1.0.0
synopsis:           Version-independent HTTP semantics (RFC 9110)
description:
  The HTTP semantics shared by every version of the protocol, as
  defined in RFC 9110. This package does no IO and knows nothing
  about the wire format of HTTP/1.1, HTTP/2 or HTTP/3.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Jeremy Shaw
maintainer:         jeremy@seereason.com
category:           Web
build-type:         Simple
extra-source-files: test/data/README.md
                    test/data/wpt/*.json
                    test/data/wpt/*.md
                    test/data/wpt/*.txt
                    test/data/seclists/*.txt
                    test/data/seclists/LICENSE
                    test/data/payloadsallthethings/*.txt
                    test/data/payloadsallthethings/*.py
                    test/data/payloadsallthethings/LICENSE
                    test/data/structured-field-tests/*.json
                    test/data/structured-field-tests/LICENSE.md
                    test/differential/ipv6.py

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  ghc-options:      -O2
  exposed-modules:  Hyperdrive.Semantics.ControlData
                    Hyperdrive.Semantics.Field
                    Hyperdrive.Semantics.FieldSyntax
                    Hyperdrive.Semantics.Internal
                    Hyperdrive.Semantics.Message
                    Hyperdrive.Semantics.Method
                    Hyperdrive.Semantics.SafePath
                    Hyperdrive.Semantics.Status
                   Hyperdrive.Semantics.StructuredField
                    Hyperdrive.Semantics.Syntax
                    Hyperdrive.Semantics.Target
                    Hyperdrive.Semantics.URI
  build-depends:    base       >= 4.18 && < 5
                  , bytestring >= 0.11 && < 0.13
                  , containers >= 0.6  && < 0.9

test-suite hyperdrive-semantics-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    ComplexityTests
                    ExhaustiveTests
                    ControlDataTests
                    FieldSyntaxTests
                    Grammar
                    GrammarTests
                    IndependentTests
                    MessageTests
                    ReviewTests
                    SafePathTests
                    SecurityTests
                    StructuredFieldTests
                    ThirdPartyTests
                    URITests
  default-language: GHC2021
  build-depends:    base
                  , aeson            >= 2.0  && < 2.3
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , scientific
                  , text
                  , hyperdrive-abnf
                  , hyperdrive-semantics
                  , QuickCheck       >= 2.14 && < 2.18
                  , tasty            >= 1.4  && < 1.6
                  , tasty-quickcheck >= 0.10 && < 0.12

-- Compares our parsing and rendering with other implementations, run as
-- separate programs: Python's ipaddress module, through
-- test/differential/ipv6.py. Needs python3 on the PATH (or in $PYTHON).
test-suite hyperdrive-semantics-differential
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test/differential test
  main-is:          Main.hs
  other-modules:    Grammar
  default-language: GHC2021
  build-depends:    base
                  , aeson
                  , bytestring
                  , containers
                  , hyperdrive-abnf
                  , hyperdrive-semantics
                  , process          >= 1.6  && < 1.7
                  , QuickCheck
                  , tasty
                  , tasty-quickcheck
