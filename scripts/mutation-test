#!/usr/bin/env python3
"""Mutation testing: check that the test suite catches deliberate bugs.

Each mutant in a package's `mutants` file replaces one exact piece of
source code with a buggy version. For each mutant, this script builds
and tests a temporary copy of the project with that one change applied.
Only the package the mutant is in is built and tested: a mutant cannot
change what another package's tests check.
A mutant is

  CAUGHT    if the test suite fails, or if the build fails because a
            quasiquoter rejected its input (a grammar checked at
            compile time is a test that runs during the build),
  SURVIVED  if the test suite still passes: the tests have a blind spot,
  INVALID   if the mutated code does not compile for any other reason, and
  STALE     if the original code no longer appears exactly once, which
            means the mutants file is out of date with the source.

The script exits with a non-zero status unless every mutant is caught.
The working tree is never modified.

Usage (from the repository root, inside `nix develop`):

  scripts/mutation-test [-j N] [--only FILE ...] [PACKAGE-DIR ...]

PACKAGE-DIR defaults to every directory with a `mutants` file.

--only FILE runs just the mutants of that source file (given as in the
`file:` line, or by its name alone), and can be repeated. When only
some source files have changed and the tests have only been added to,
the other mutants cannot have changed result, so running the changed
files' mutants is enough. After changing existing code broadly, or
removing or weakening tests, run them all.

-j N runs N mutants at once, each in its own copy of the project. Each
copy is built from scratch first (a copied build directory still points
at the original's paths), so a few mutants are quicker with fewer
copies; the default is one copy per four mutants, at most 6.

A package whose `mutants` file says `parallel: no` (one with tests
that measure time) has its mutants run one at a time, after all the
others, with nothing else running.

A test suite is stopped at its first failing test: that is enough to
know the mutant is caught. Test binaries are run directly, from the
package's directory, as `cabal test` would.

To see how strong one part of the test suite is on its own, pass
options to the test runner through MUTATION_TEST_OPTIONS, for example
MUTATION_TEST_OPTIONS='-p Exhaustive'.

Format of the `mutants` file:

  # comments and blank lines are ignored
  parallel: no        (optional, anywhere)
  file: src/Hyperdrive/Semantics/URI.hs
  why: an IPv6 address with "::" has at most 7 explicit pieces
  - guard (n <= 7)
  + guard (n <= 8)

`file:` applies to the mutants after it. `why:` is optional and is
printed when a mutant survives. Each `-` line is the original code and
must be followed by a `+` line with its replacement.
"""

import argparse
import os
import queue
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
from dataclasses import dataclass
from pathlib import Path

# every dependency comes from the Nix package database, so the package
# index is not needed; reading it from several copies at once lets them
# overwrite one another's regenerated index cache
CABAL = ["cabal", "--offline", "--active-repositories=:none"]
TEST_OPTIONS = shlex.split(os.environ.get("MUTATION_TEST_OPTIONS", ""))
FAIL_LINE = re.compile(r":\s+FAIL\b")


@dataclass
class Mutant:
    file: str
    old: str
    new: str
    why: str
    line: int  # in the mutants file


def parse_mutants(path):
    """The mutants in a file, and whether they may run in parallel."""
    mutants, file, why, old, parallel = [], None, "", None, True
    for n, raw in enumerate(path.read_text().splitlines(), start=1):
        line = raw.rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line.startswith("parallel:"):
            parallel = line[len("parallel:"):].strip() != "no"
        elif line.startswith("file:"):
            file = line[len("file:"):].strip()
        elif line.startswith("why:"):
            why = line[len("why:"):].strip()
        elif line.startswith("- "):
            old = (line[2:], n)
        elif line.startswith("+ "):
            if old is None or file is None:
                sys.exit(f"{path}:{n}: '+' line without a preceding 'file:' and '-' line")
            mutants.append(Mutant(file, old[0], line[2:], why, old[1]))
            old, why = None, ""
        else:
            sys.exit(f"{path}:{n}: cannot parse: {line}")
    if old is not None:
        sys.exit(f"{path}:{old[1]}: '-' line without a following '+' line")
    return mutants, parallel


def run(cmd, cwd):
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)


def selected(m, only):
    return not only or any(m.file == f or m.file.endswith("/" + f) for f in only)


def test_suites(pkg_dir):
    """The names of a package's test suites, from its .cabal file,
    without those that are only built with a flag (their stanza says
    'buildable: False')."""
    names = []
    for cabal in pkg_dir.glob("*.cabal"):
        for stanza in re.split(r"^(?=\S)", cabal.read_text(), flags=re.MULTILINE):
            suite = re.match(r"test-suite\s+(\S+)", stanza)
            if suite and not re.search(r"buildable:\s*False", stanza, re.IGNORECASE):
                names.append(suite.group(1))
    return names


class Copy:
    """One copy of the project, in which mutants are built and tested."""

    def __init__(self, root, tmp, index):
        self.work = Path(tmp) / f"repo-{index}"
        shutil.copytree(root, self.work, ignore=shutil.ignore_patterns("dist-newstyle", "dist-llhttp", ".git", ".duvet"))
        self.binaries = {}

    def build(self, pkg):
        return run(CABAL + ["build", str(pkg)], self.work)

    def test(self, pkg, stop_at_first_failure=True):
        """Run the package's test suites; True if they all pass. Each is
        stopped at its first failing test."""
        for suite in test_suites(self.work / pkg):
            key = (str(pkg), suite)
            if key not in self.binaries:
                found = run(CABAL + ["list-bin", "-v0", f"{pkg}:test:{suite}"], self.work)
                if found.returncode != 0:
                    return False, found.stdout + found.stderr
                self.binaries[key] = found.stdout.strip().splitlines()[-1]
            proc = subprocess.Popen([self.binaries[key], "--color", "never", "--hide-successes"] + TEST_OPTIONS,
                                    cwd=self.work / pkg, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            output = []
            failed = False
            for line in proc.stdout:
                output.append(line)
                if stop_at_first_failure and FAIL_LINE.search(line):
                    failed = True
                    proc.kill()
                    break
            proc.wait()
            if failed or proc.returncode != 0:
                return False, "".join(output)
        return True, ""


def try_mutant(copy, pkg, m):
    target = copy.work / pkg / m.file
    original = target.read_text()
    count = original.count(m.old)
    if count != 1:
        return "STALE", f"original code found {count} times"
    target.write_text(original.replace(m.old, m.new))
    try:
        build = copy.build(pkg)
        if build.returncode != 0:
            if "In the quasi-quotation" in build.stdout + build.stderr:
                return "CAUGHT", "at compile time, by a quasiquoter"
            return "INVALID", ""
        passed, _ = copy.test(pkg)
        return ("SURVIVED" if passed else "CAUGHT"), ""
    finally:
        target.write_text(original)


def main():
    parser = argparse.ArgumentParser(description="Check that the test suite catches deliberate bugs.")
    parser.add_argument("--only", action="append", default=[], metavar="FILE",
                        help="only run the mutants of this source file (repeatable)")
    parser.add_argument("-j", "--jobs", type=int, default=None,
                        help="mutants to run at once, each in its own copy (default: one per four mutants, at most 6)")
    parser.add_argument("packages", nargs="*", metavar="PACKAGE-DIR")
    args = parser.parse_args()

    # turn SIGTERM into an exception, so that the temporary copies are
    # removed and running builds or tests are killed on the way out
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit("terminated"))

    root = Path(__file__).resolve().parent.parent
    packages = [Path(p) for p in args.packages] or sorted(p.parent.relative_to(root) for p in root.glob("*/mutants"))
    if not packages:
        sys.exit("no mutants files found")

    parallel_mutants, serial_mutants = [], []
    for pkg in packages:
        ms, parallel = parse_mutants(root / pkg / "mutants")
        (parallel_mutants if parallel else serial_mutants).extend((pkg, m) for m in ms if selected(m, args.only))
    mutants = parallel_mutants + serial_mutants
    if not mutants:
        files = sorted({ m.file for pkg in packages for m in parse_mutants(root / pkg / "mutants")[0] })
        sys.exit("no mutants for " + ", ".join(args.only) + "; files with mutants:\n  " + "\n  ".join(files))
    jobs = args.jobs or max(1, min(6, len(parallel_mutants) // 4))
    jobs = max(1, min(jobs, len(parallel_mutants) or 1))
    print(f"{len(mutants)} mutants to run, {jobs} at a time"
          + (f" ({len(serial_mutants)} of them one at a time, at the end)" if serial_mutants else ""), flush=True)

    with tempfile.TemporaryDirectory(prefix="mutation-test-") as tmp:
        # A cabal directory of our own, with no package index in it: the
        # shared one's index cache is rewritten by any cabal-install of
        # another version, and the copies, rebuilding it at once,
        # corrupted it. Every dependency is in the Nix package database.
        os.environ["CABAL_DIR"] = str(Path(tmp) / "cabal")
        # its default config is written once, before the copies use it
        run(["cabal", "user-config", "init"], tmp)
        print("copying, building and testing the unmodified project ...", flush=True)
        copies = [Copy(root, tmp, i) for i in range(jobs)]
        targets = sorted({ pkg for pkg, _ in mutants }, key=str)

        # the first copy checks the unmodified project; the others only
        # need building, which they do at the same time
        errors = []

        def prepare(copy, check):
            for pkg in targets:
                b = copy.build(pkg)
                if b.returncode != 0:
                    errors.append(b.stdout[-3000:] + b.stderr[-3000:])
                    return
                if check:
                    passed, output = copy.test(pkg, stop_at_first_failure=False)
                    if not passed:
                        errors.append(output[-5000:])
                        return

        # one build alone first, so that cabal sets up its store and
        # package database before several copies use them at once
        first = copies[0].build(targets[0])
        if first.returncode != 0:
            print(first.stdout[-3000:] + first.stderr[-3000:])
            sys.exit("the unmodified project does not build; fix that first")
        threads = [threading.Thread(target=prepare, args=(c, i == 0)) for i, c in enumerate(copies)]
        for t in threads:
            t.start()
        for t in threads:
            t.join()
        if errors:
            print(errors[0])
            sys.exit("the unmodified project does not build or pass its tests; fix that first")

        results = {}
        lock = threading.Lock()

        def report(pkg, m, status, note):
            where = f"{pkg}/mutants:{m.line} {pkg}/{m.file}"
            with lock:
                results[(str(pkg), m.line)] = (status, where, m, note)
                print(f"{status:9} {where}" + (f" ({note})" if note else ""), flush=True)

        def work(copy, todo):
            while True:
                try:
                    pkg, m = todo.get_nowait()
                except queue.Empty:
                    return
                status, note = try_mutant(copy, pkg, m)
                report(pkg, m, status, note)

        # the mutants that may run together, then the others alone
        todo = queue.Queue()
        for item in parallel_mutants:
            todo.put(item)
        threads = [threading.Thread(target=work, args=(c, todo)) for c in copies]
        for t in threads:
            t.start()
        for t in threads:
            t.join()
        todo = queue.Queue()
        for item in serial_mutants:
            todo.put(item)
        work(copies[0], todo)

    ordered = [results[k] for k in sorted(results)]
    bad = [r for r in ordered if r[0] != "CAUGHT"]
    print(f"\n{len(ordered) - len(bad)} of {len(ordered)} mutants caught")
    for status, where, m, note in bad:
        print(f"\n{status}: {where}")
        print(f"  - {m.old}\n  + {m.new}")
        if m.why:
            print(f"  why it matters: {m.why}")
        if note:
            print(f"  {note}")
    sys.exit(1 if bad else 0)


if __name__ == "__main__":
    main()
