#!/usr/bin/env python3
"""Summarize a perf profile of a Haskell program: the share of samples
by package and module (and the runtime system's, by function), and the
program's own hottest functions, optionally in microseconds a request.
Module-local names (s1Ab_info and the like: closures and continuations
of any module) and addresses without a name are counted on their own;
perf attributes them to no module.

    scripts/perf-summary [--dso NAME] [--us-per-request US] [--top N] PERF.DATA

--us-per-request scales each share of all samples by the CPU a request
takes (from scripts/bench-cpu, user plus kernel). perf must be on the
path (nix shell nixpkgs#perf), and the program built unstripped.
"""
import argparse
import collections
import re
import subprocess

parser = argparse.ArgumentParser()
parser.add_argument('data')
parser.add_argument('--dso', help='only this binary (default: all)')
parser.add_argument('--us-per-request', type=float)
parser.add_argument('--top', type=int, default=20)
parser.add_argument('--binary', help='the profiled binary: addresses perf could not name are '
                    'attributed to the symbol before them (needs nm: nix shell nixpkgs#binutils)')
args = parser.parse_args()

# perf names code only at symbols, and GHC leaves many local labels out
# of the symbol table, so code after them shows as file offsets; the
# symbol before an address is the function it belongs to
symbols = []
if args.binary:
    nm = subprocess.run(['nm', '-n', '--defined-only', args.binary], capture_output=True, text=True, check=True).stdout
    for line in nm.splitlines():
        parts = line.split()
        if len(parts) == 3 and parts[1] in 'tT':
            symbols.append((int(parts[0], 16), parts[2]))
    import bisect
    addresses = [a for a, _ in symbols]


def name_address(sym):
    if not symbols:
        return sym
    offset = int(sym, 16)
    # a non-PIE executable is loaded at 0x400000, and perf prints offsets
    for addr in (offset, offset + 0x400000):
        i = bisect.bisect_right(addresses, addr) - 1
        if i >= 0 and addr - addresses[i] < 0x10000:
            return symbols[i][1]
    return sym

# sample counts rather than the printed percentages, which round the
# many small Haskell symbols to 0.00%
cmd = ['perf', 'report', '-i', args.data, '--sort', 'dso,symbol', '--stdio', '-g', 'none', '-n']
report = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


# GHC's Z-encoding of names in symbols
ZCODES = {'z': {'a': '&', 'b': '|', 'c': '^', 'd': '$', 'e': '=', 'g': '>', 'h': '#',
                'i': '.', 'l': '<', 'm': '-', 'n': '!', 'p': '+', 'q': "'", 'r': '\\',
                's': '/', 't': '*', 'u': '_', 'v': '%', 'z': 'z'},
          'Z': {'L': '(', 'R': ')', 'M': '[', 'N': ']', 'C': ':', 'Z': 'Z'}}


def unzencode(s):
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c in ZCODES and i + 1 < len(s) and s[i + 1] in ZCODES[c]:
            out.append(ZCODES[c][s[i + 1]])
            i += 2
        else:
            out.append(c)
            i += 1
    return ''.join(out)


def classify(sym):
    """(group, name): a Haskell symbol's package and module, or the
    runtime system's function."""
    m = re.match(r'([a-z0-9]+(?:zm[a-z0-9]+)*?)zm[0-9zi]+(?:zm[A-Za-z0-9]+)?_(\w+?)_', sym)
    if m:
        return unzencode(m.group(1)), unzencode(m.group(2))
    m = re.match(r'(base|ghczmprim|ghczminternal|ghczmbignum)_(\w+?)_', sym)
    if m:
        return unzencode(m.group(1)), unzencode(m.group(2))
    # a name local to some module (a closure, continuation or worker),
    # which says nothing of where it is from
    if re.match(r'^[a-z][0-9A-Za-z]{2,6}_(info|entry|closure|con_info|slow)$', sym):
        return 'local names (any module)', sym
    if re.match(r'^0x[0-9a-f]+$', sym):
        return 'unnamed addresses', sym
    return 'runtime system', sym


rows = []
for line in report.splitlines():
    m = re.match(r'\s+[\d.]+%\s+(\d+)\s+(\S+)\s+\[([.k])\]\s+(\S+)', line)
    if m:
        rows.append((int(m.group(1)), m.group(2), m.group(3), m.group(4).split('+')[0]))
total = sum(r[0] for r in rows)

dsos = collections.Counter()
groups = collections.Counter()
modules = collections.Counter()
functions = collections.Counter()
for samples, dso, kind, sym in rows:
    share = 100 * samples / total
    if re.match(r'^0x[0-9a-f]+$', sym) and (not args.dso or dso == args.dso):
        sym = name_address(sym)
    dsos[dso] += share
    if args.dso and dso != args.dso:
        continue
    if kind == 'k':
        continue
    group, name = classify(sym)
    groups[group] += share
    modules[(group, name)] += share
    if group not in ('runtime system', 'local names (any module)', 'unnamed addresses'):
        functions[unzencode(re.sub(r'zm[0-9zi]+(zm[A-Za-z0-9]+)?_', ':', sym))] += share


def show(share):
    if args.us_per_request:
        return f'{share:6.2f}%  {share / 100 * args.us_per_request:6.3f} us'
    return f'{share:6.2f}%'


print('by binary:')
for dso, share in dsos.most_common(6):
    print(f'  {show(share)}  {dso}')
print('by package' + (f' (in {args.dso})' if args.dso else '') + ':')
for group, share in groups.most_common(12):
    print(f'  {show(share)}  {group}')
print('by module, and the runtime system by function:')
for (group, name), share in [m for m in modules.most_common() if m[0][0] not in ('local names (any module)', 'unnamed addresses')][:args.top]:
    print(f'  {show(share)}  {group:24} {name}')
print('functions outside the runtime system:')
for name, share in functions.most_common(args.top):
    print(f'  {show(share)}  {name[:110]}')
