#!/usr/bin/env bash
# The TLS spike (docs/tls-spike-design.md): test certificates, the QUIC
# handshake in process, handshakes and records in process, then real
# clients (openssl s_client, curl, nghttp) against the spike's server.
#
#   nix develop .#tls -c scripts/tls-spike
#
# Not a timing run: the numbers are for orders of magnitude; for
# percentiles worth comparing, ask for a quiet machine first.
set -euo pipefail
cd "$(dirname "$0")/.."
dir=$(mktemp -d)
trap 'rm -rf "$dir"; [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null || true' EXIT
for k in ec rsa; do
  case $k in
    ec) key=(-newkey ec -pkeyopt ec_paramgen_curve:P-256) ;;
    rsa) key=(-newkey rsa:2048) ;;
  esac
  openssl req -x509 "${key[@]}" -nodes -keyout "$dir/$k.key" -out "$dir/$k.pem" -days 1 \
    -subj /CN=localhost -addext subjectAltName=DNS:localhost 2>/dev/null
done
cabal build -v0 tls-spike
spike=$(cabal list-bin -v0 tls-spike)

echo "== QUIC handshake, in process"
"$spike" quic "$dir/ec.pem" "$dir/ec.key"
for k in ec rsa; do
  echo "== handshakes and records in process, $k"
  "$spike" bench "$dir/$k.pem" "$dir/$k.key" 2000
done

port=18443
"$spike" serve "$port" "$dir/rsa.pem" "$dir/rsa.key" > "$dir/server.log" 2>&1 & pid=$!
for _ in $(seq 50); do (exec 3<>/dev/tcp/127.0.0.1/$port) 2>/dev/null && break; sleep 0.1; done
echo "== real clients"
echo | openssl s_client -connect 127.0.0.1:$port -servername localhost -alpn h2 -tls1_3 2>&1 \
  | grep -E '^New,|ALPN protocol' || true
printf 'GET / HTTP/1.1\r\nHost: localhost\r\n\r\n' | openssl s_client -connect 127.0.0.1:$port \
  -servername localhost -alpn http/1.1 -tls1_2 -ign_eof 2>&1 | grep -E '^New,|ALPN protocol|^hello' || true
echo | openssl s_client -connect 127.0.0.1:$port -alpn h3 2>&1 | grep -o 'alert no application protocol' || true
curl -sk --http1.1 https://localhost:$port/ -w '  curl: HTTP/%{http_version} %{response_code}\n'
curl -skv --http2 https://localhost:$port/ 2>&1 | grep -E 'ALPN: server accepted' || true
nghttp -v https://localhost:$port/ 2>&1 | grep -E 'negotiated protocol' || true
sleep 0.3
echo "== the server's log"
cat "$dir/server.log"
