cabal-version:      3.0
name:               hyperdrive-http1
version:            0.1.0.0
synopsis:           HTTP/1.1 (RFC 9112) for hyperdrive
description:
  The HTTP/1.1 protocol layer of hyperdrive: message framing, and in
  time the parser and the connection state machine. It does no IO.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Jeremy Shaw
maintainer:         jeremy@seereason.com
category:           Web
build-type:         Simple

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  exposed-modules:  Hyperdrive.HTTP1.Chunked
                    Hyperdrive.HTTP1.Connection
                    Hyperdrive.HTTP1.Framing
                    Hyperdrive.HTTP1.Head
                    Hyperdrive.HTTP1.Target
  build-depends:    base                 >= 4.18 && < 5
                  , bytestring           >= 0.11 && < 0.13
                  , hyperdrive-semantics

test-suite hyperdrive-http1-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    ChunkedTests
                    ConnectionTests
                    FramingTests
                    HeadTests
                    TargetTests
  default-language: GHC2021
  build-depends:    base
                  , bytestring
                  , hyperdrive-abnf
                  , hyperdrive-http1
                  , hyperdrive-semantics
                  , QuickCheck       >= 2.14 && < 2.18
                  , tasty            >= 1.4  && < 1.6
                  , tasty-quickcheck >= 0.10 && < 0.12
