cabal-version:      3.0
name:               hyperdrive-tls
version:            0.1.0.0
synopsis:           TLS for hyperdrive, through a small C shim over AWS-LC
description:
  Our own thin TLS binding (docs/http2-core-design.md, D3): a C shim
  over AWS-LC whose callbacks only fill buffers, so that no callback
  enters Haskell, serving TCP (HTTP/1.1, HTTP/2) and QUIC (HTTP/3)
  (docs/tls-design.md).
license:            BSD-3-Clause
license-file:       LICENSE
author:             Jeremy Shaw
maintainer:         jeremy@seereason.com
category:           Web
build-type:         Simple
extra-source-files: cbits/hd_tls.h
                    test/data/*.pem
                    test/data/*.key

common warnings
  ghc-options: -Wall

library
  import:            warnings
  hs-source-dirs:    src
  default-language:  GHC2021
  exposed-modules:   Hyperdrive.TLS
                     Hyperdrive.TLS.Shim
  build-depends:     base >= 4.18 && < 5
                   , bytestring >= 0.11 && < 0.13
  c-sources:         cbits/hd_tls.c
  include-dirs:      cbits
  cc-options:        -O2 -Wall
  -- AWS-LC as nixpkgs installs it, beside OpenSSL: libssl-awslc
  pkgconfig-depends: libssl-awslc, libcrypto-awslc

test-suite hyperdrive-tls-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  default-language: GHC2021
  ghc-options:      -threaded
  build-depends:    base
                  , bytestring
                  , containers
                  , hyperdrive-tls
                  , QuickCheck       >= 2.14 && < 2.18
                  , tasty            >= 1.4  && < 1.6
                  , tasty-quickcheck >= 0.10 && < 0.12
