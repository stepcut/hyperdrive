cabal-version:      3.0
name:               hyperdrive-tls
version:            0.1.0.0
synopsis:           TLS for hyperdrive, through a small C shim over AWS-LC
description:
  Our own thin TLS binding (docs/http2-core-design.md, D3): a C shim
  over AWS-LC whose callbacks only fill buffers, so that no callback
  enters Haskell, serving TCP (HTTP/1.1, HTTP/2) and QUIC (HTTP/3). For
  now the spike of docs/tls-spike-design.md.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Jeremy Shaw
maintainer:         jeremy@seereason.com
category:           Web
build-type:         Simple
extra-source-files: cbits/hd_tls.h

common warnings
  ghc-options: -Wall

library
  import:            warnings
  hs-source-dirs:    src
  default-language:  GHC2021
  exposed-modules:   Hyperdrive.TLS.Shim
  build-depends:     base >= 4.18 && < 5
  c-sources:         cbits/hd_tls.c
  include-dirs:      cbits
  cc-options:        -O2 -Wall
  -- AWS-LC as nixpkgs installs it, beside OpenSSL: libssl-awslc
  pkgconfig-depends: libssl-awslc, libcrypto-awslc

-- The spike (docs/tls-spike-design.md): serve real clients, measure
-- handshakes and records in process, run a QUIC handshake in process.
executable tls-spike
  import:           warnings
  hs-source-dirs:   app
  main-is:          Spike.hs
  default-language: GHC2021
  ghc-options:      -O2 -threaded -rtsopts
  build-depends:    base
                  , bytestring >= 0.11 && < 0.13
                  , containers >= 0.6  && < 0.8
                  , hyperdrive-tls
                  , network    >= 3.1  && < 3.3
